# =============================================================================
# Environment variables.   Setup:   cp .env.example .env   and fill in the blanks.
#
# `.env` is git-ignored. NEVER commit real keys: only this example file is tracked.
#
# Nuxt maps every `runtimeConfig` key to a NUXT_<UPPER_SNAKE_CASE> variable, so
# `openaiApiKey` in nuxt.config.ts is read from NUXT_OPENAI_API_KEY.
#
# Legend
#   [required]      the app does not work without it
#   [needed for X]  one feature needs it; the rest of the app runs without it
#   [optional]      safe to leave empty
# =============================================================================


# -----------------------------------------------------------------------------
# Database (libSQL / Turso)                                        [required]
# -----------------------------------------------------------------------------
# Both variables must be non-empty (server/utils/db.ts). Tables are created
# automatically on the first /api request (CREATE TABLE IF NOT EXISTS).
#
# Local development, no account needed. A SQLite file in the project root
# (git-ignored). With a file: URL the token is ignored but must not be empty.
NUXT_TURSO_URL=file:./local.db
NUXT_TURSO_TOKEN=local
#
# Hosted Turso (https://turso.tech) -- replace the two lines above with:
#   turso db create <name>
#   turso db show <name> --url          -> NUXT_TURSO_URL (libsql://<db>-<org>.turso.io)
#   turso db tokens create <name>       -> NUXT_TURSO_TOKEN


# -----------------------------------------------------------------------------
# Session cookie encryption (nuxt-auth-utils)           [required in production]
# -----------------------------------------------------------------------------
# At least 32 characters. In `npm run dev` it is generated and appended to .env
# automatically when missing; in production you must set it. To generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=


# -----------------------------------------------------------------------------
# OpenAI                                                           [required]
# -----------------------------------------------------------------------------
# Powers CV analysis, CV generation, coach, interview, CV import and CV audit.
# https://platform.openai.com/api-keys
NUXT_OPENAI_API_KEY=
# Interview text-to-speech. Defaults live in nuxt.config.ts; uncomment to override.
# NUXT_OPENAI_TTS_MODEL=tts-1-hd
# NUXT_OPENAI_TTS_VOICE=nova


# -----------------------------------------------------------------------------
# Email via Resend                                      [needed for sign-up]
# -----------------------------------------------------------------------------
# Sends the 6-digit verification code on sign-up and the password-reset codes.
# https://resend.com/api-keys
# Without it, sign-up still creates the account but no email goes out (the code
# is stored in the users.verification_code column) and password reset fails
# with an HTTP 500.
#
# The sender address is hard-coded as no-reply@wikisportco.com in
#   server/api/auth/signup.post.ts
#   server/utils/password-security.ts
# Change it to an address on a domain you have verified in Resend.
NUXT_RESEND_API_KEY=


# -----------------------------------------------------------------------------
# Google sign-in                                                   [optional]
# -----------------------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials  (OAuth client ID, web app)
# Authorized redirect URI: http://localhost:3000/auth/google
# (add your production origin + /auth/google as well)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Job offers search (Jooble)                    [needed for the job-offers page]
# -----------------------------------------------------------------------------
# https://jooble.org/api/about
# Without it POST /api/jobs answers HTTP 500 ("Jooble API key no configurada").
NUXT_JOOBLE_API_KEY=


# -----------------------------------------------------------------------------
# Payments via Bold (Colombia, prices in COP)         [needed to sell Pro plan]
# -----------------------------------------------------------------------------
# https://bold.co
#   NUXT_BOLD_ID      "llave de identidad" (production). Creates payment links.
#   NUXT_BOLD_SECRET  "llave secreta" (production). Verifies webhook signatures.
NUXT_BOLD_ID=
NUXT_BOLD_SECRET=
# Base price of the Pro plan in COP (falls back to 32500 when empty or invalid).
NUXT_BOLD_PAYMENT_AMOUNT=32500
#
# !!! BOLD TEST MODE: keep this commented out in production !!!
# Defining NUXT_TEST_BOLD_ID switches the whole app to test mode: checkout uses
# this key INSTEAD of NUXT_BOLD_ID, and the payment webhook verifies signatures
# with an EMPTY secret (Bold's test-mode convention). With an empty secret anyone
# can forge a "payment approved" event. Use it on your own machine only.
# NUXT_TEST_BOLD_ID=


# -----------------------------------------------------------------------------
# Static API token                                                 [optional]
# -----------------------------------------------------------------------------
# Lets non-browser clients (e.g. a cron job) call /api/* without a user session:
#   curl -H "Authorization: Bearer $NUXT_API_TOKEN" -X POST <origin>/api/...
# Leave empty to disable. If set, make it long and random (see the session
# password above for a one-liner).
NUXT_API_TOKEN=
